# MongoDB (Atlas connection string or local)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=ovis-demo

# JWT secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Comma-separated browser origins allowed to call the API. Unset = allow all (dev only).
CORS_ORIGINS=https://app.ovismedical.com,http://localhost:5173

# --- Inference ---------------------------------------------------------------
# Provider "openai": Responses API with structured outputs. Leave the key empty to run in
# fallback mode (app works, Florence replies with a placeholder, questionnaire triage is skipped).
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
# Optional: point the "openai" provider at Azure OpenAI / Foundry (BAA-covered), OpenRouter, etc.
# For Azure use the resource's v1 endpoint and set OPENAI_MODEL to your *deployment* name.
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# Optional per-task models (Azure: deployment names). Unset = OPENAI_MODEL. Recommended split:
# OPENAI_TRIAGE_MODEL=gpt-5
# OPENAI_ASSESSMENT_MODEL=gpt-5-mini
# OPENAI_CHAT_MODEL=gpt-5-mini

# Provider "local": any OpenAI-compatible server inside your network (Ollama, vLLM), e.g. MedGemma.
# LOCAL_INFERENCE_URL=http://localhost:11434/v1
# LOCAL_INFERENCE_MODEL=medgemma
# LOCAL_INFERENCE_API_KEY=ollama

# Which provider handles which task ("openai" or "local"). Unset = openai.
# INFERENCE_ROUTE_CHAT=local
# INFERENCE_ROUTE_ASSESSMENT=openai
# INFERENCE_ROUTE_TRIAGE=openai

# --- Optional integrations ---------------------------------------------------
# Twilio Verify for email OTP at sign-up. When unset, the frontend uses direct registration (/register).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Google Calendar (doctor scheduling)
CALENDAR_ENCRYPTION_KEY=your-encryption-key-here
# CALENDAR_SECRET_FILE=client_secret.json
# BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

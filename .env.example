# MongoDB (Atlas connection string or local)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=ovis-demo

# JWT secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Comma-separated browser origins allowed to call the API. Unset = allow all (dev only).
CORS_ORIGINS=https://app.ovismedical.com,http://localhost:5173

# --- Inference ---------------------------------------------------------------
# Provider "openai": Responses API with structured outputs. Leave the key empty to run in
# fallback mode (app works, Florence replies with a placeholder, questionnaire triage is skipped).
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
# Optional: point the "openai" provider at Azure OpenAI / Foundry (BAA-covered), OpenRouter, etc.
# For Azure use the resource's v1 endpoint and set OPENAI_MODEL to your *deployment* name.
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# Optional per-task models (Azure: deployment names). Unset = OPENAI_MODEL. Recommended split:
# OPENAI_TRIAGE_MODEL=gpt-5
# OPENAI_ASSESSMENT_MODEL=gpt-5-mini
# OPENAI_CHAT_MODEL=gpt-5-mini

# Provider "local": any OpenAI-compatible server inside your network (Ollama, vLLM), e.g. MedGemma.
# LOCAL_INFERENCE_URL=http://localhost:11434/v1
# LOCAL_INFERENCE_MODEL=medgemma
# LOCAL_INFERENCE_API_KEY=ollama

# Which provider handles which task ("openai" or "local"). Unset = the provider named for the task in
# app/inference/routing_policy.yaml (openai for chat/assessment/triage). Set only to override the policy.
# INFERENCE_ROUTE_CHAT=local
# INFERENCE_ROUTE_ASSESSMENT=openai
# INFERENCE_ROUTE_TRIAGE=openai

# --- Compliance gate (app/inference/routing_policy.yaml) --------------------------
# NOT REQUIRED TODAY. The "openai" provider requires only that the request was de-identified by the
# scrubber; this flag is declared in the policy but left out of `requires` while we demo, because
# Azure OpenAI already sits under Microsoft's terms and gating on a self-asserted flag only risks a
# silent outage. Nothing needs to be set here.
# To turn the contractual gate back on: add `dpa_ok` to `providers.openai.requires` in
# routing_policy.yaml and set this to true once the Microsoft DPA covers the Azure subscription and
# the abuse-monitoring status is recorded in docs/compliance/processors.md. It then fails closed:
# Florence answers with a scripted fallback, assessments and triage are saved as
# pending_clinician_review, /health reports florence_ai: "refusing" and the startup log warns.
# COMPLIANCE_DPA_OK=true
# Optional: load the routing policy from another file (default: app/inference/routing_policy.yaml).
# INFERENCE_POLICY_PATH=/etc/ovis/routing_policy.yaml
# Optional NER backend for the PHI scrubber: none (default; deterministic layers only) | presidio | gliner.
# presidio/gliner need their extra packages installed; if configured but unavailable, scrubbing fails closed.
# SCRUB_NER_BACKEND=none

# --- Optional integrations ---------------------------------------------------
# Twilio Verify for email OTP at sign-up. When unset, the frontend uses direct registration (/register).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Google Calendar (doctor scheduling)
CALENDAR_ENCRYPTION_KEY=your-encryption-key-here
# CALENDAR_SECRET_FILE=client_secret.json
# BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
